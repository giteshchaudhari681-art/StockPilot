# StockPilot Repository GitIgnore

# Node.js & Package Managers
node_modules/
.pnpm-store/
.npm/

# Python & ML Service
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Frontend & Next.js Build Outputs
.next/
out/
dist/
build/

# Environment Variables & Secrets
.env
.env*.local
*.env
!.env.example
!frontend/.env.example
!backend/.env.example
!ml-service/.env.example
*.pem
*.key

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage Artifacts
coverage/
.nyc_output/
playwright-report/
test-results/

# System & OS Files
.DS_Store
Thumbs.db
*.tmp
*.temp
*.swp
*.swo

# IDE & Editor Configuration
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
