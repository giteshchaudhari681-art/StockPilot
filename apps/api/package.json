{
  "name": "@stockpilot/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "StockPilot backend API application",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=../../prisma/schema.prisma",
    "prebuild": "npm run prisma:generate && npm run build -w @stockpilot/shared",
    "build": "tsc",
    "start": "node dist/index.js",
    "pretypecheck": "npm run prisma:generate && npm run build -w @stockpilot/shared",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "echo \"Lint not yet configured — see PR 02\"",
    "pretest": "npm run prisma:generate",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test \"test/config.test.js\" \"test/test-infrastructure.test.js\" \"test/database-foundation.test.js\"",
    "test:integration": "node --test \"test/api-foundation.test.js\" \"test/error-integration.test.js\" \"test/logging-integration.test.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@stockpilot/shared": "*",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "prisma": "^6.19.3",
    "tsx": "^4.7.1",
    "typescript": "^5.7.3"
  }
}
