{
  "name": "@stockpilot/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "StockPilot backend API application",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build -w @stockpilot/shared",
    "build": "tsc",
    "start": "node dist/index.js",
    "pretypecheck": "npm run build -w @stockpilot/shared",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "echo \"Lint not yet configured — see PR 02\"",
    "test": "node --test"
  },
  "dependencies": {
    "@stockpilot/shared": "*",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.1",
    "typescript": "^5.7.3"
  }
}
