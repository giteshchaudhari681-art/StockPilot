# StockPilot — Environment Variables Template
#
# Copy this file to .env in the project root and fill in real values.
# NEVER commit .env — it is in .gitignore.
# NEVER put real credentials in this file.
#
# Usage:
#   cp .env.example .env
#   # Then edit .env with your local values

# ─── Application ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────
# Connection string for the PostgreSQL database.
# Local development uses Docker Compose (see docker-compose.yml).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL=postgresql://stockpilot_user:replace_with_password@localhost:5432/stockpilot_db?schema=public

# ─── Cache & Queue (Redis) ────────────────────────────────────────────────
# Connection string for the Redis instance.
# Local development uses Docker Compose.
REDIS_URL=redis://localhost:6379

# ─── Authentication & Security ────────────────────────────────────────────
# Replace with a cryptographically secure random string (min 64 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_secure_random_jwt_secret_min_64_chars
JWT_EXPIRES_IN=7d

# ─── Service URLs ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
ML_SERVICE_URL=http://localhost:8000