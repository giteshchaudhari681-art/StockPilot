# StockPilot Master Environment Variables Template

NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://stockpilot_user:stockpilot_password@localhost:5432/stockpilot_db?schema=public

# Cache & Queue Configuration (Redis)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=replace_with_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# Microservice URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
ML_SERVICE_URL=http://localhost:8000