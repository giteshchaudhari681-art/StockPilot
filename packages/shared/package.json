{
  "name": "@stockpilot/shared",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "StockPilot shared types, constants, and contracts — consumed by all apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "test": "node --test",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "pino": "^10.4.0"
  }
}
